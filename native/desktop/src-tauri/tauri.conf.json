  "productName": "Tienda Eaciot",
  "version": "1.0.0",
  "identifier": "com.eaciot.tienda",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
