APP_NAME=Tienda Eaciot
APP_SECRET_KEY=change-me-to-random-secret
FRONTEND_URL=https://tienda.eaciot.com
DEBUG=false
FORCE_HTTPS=true
ALLOWED_HOSTS=tienda.eaciot.com,www.tienda.eaciot.com,*.nixopus.ai

# SQLite persistente en el volumen Docker /var/data (Coolify / Dokploy / compose).
# docker-compose.yml monta el volumen app-data en /var/data; no cambies esto.
DATABASE_URL=sqlite+aiosqlite:////var/data/app.db

# El bootstrap crea el admin automáticamente si ambos están definidos.
ADMIN_EMAIL=admin@eaciot.com
ADMIN_PASSWORD=change-me-strong-password

OLLAMA_HOST=https://api.ollama.com
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_API_KEY=

# OpenCode Go (secondary LLM provider — OpenAI-compatible)
# Base real: https://opencode.ai/zen/go (+ /v1/chat/completions)
OPENCODE_HOST=https://opencode.ai/zen/go
OPENCODE_MODEL=minimax-m3
OPENCODE_API_KEY=your-opencode-key

STRIPE_SECRET_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PUBLISHABLE_KEY=pk_live_your-key

# CFDI / Facturación electrónica
# Sin credenciales PAC/CSD ni FACTURAPI, el sistema emite comprobantes
# imprimibles provisionales (fallback) — la tienda nunca se rompe.
PAC_PROVIDER=finkok
PAC_ENVIRONMENT=production
PAC_USERNAME=
PAC_PASSWORD=
CSD_PASSWORD=
FACTURAPI_API_KEY=
FACTURAPI_BASE_URL=https://www.facturapi.io/v2
BUSINESS_RFC=EAC2403183F0
BUSINESS_NAME=EMANUEL AZUR CORPORATIVO SAS DE CV
BUSINESS_TAX_REGIME=601
BUSINESS_ZIP_CODE=62410
BUSINESS_IVA_RATE=0.16

# SMTP Configuration (SendGrid example)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-key
SMTP_FROM=noreply@eaciot.com
SMTP_TLS=true

# Google OAuth (los botones sin credenciales se ocultan en el login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tienda.eaciot.com/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://tienda.eaciot.com/auth/microsoft/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://tienda.eaciot.com/auth/github/callback

# Optional AI services
SEMANTIC_SEARCH_ENABLED=false
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=master_key

# Visual search requires open_clip + torch (install requirements-ai-innovations.txt)
# No extra env vars needed; runs via Ollama/CLIP when dependencies are present.

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
