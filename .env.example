APP_NAME=Tienda Eaciot
APP_SECRET_KEY=change-me-to-random-secret
FRONTEND_URL=https://tienda.eaciot.com
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tienda_eaciot

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# OpenCode Go (secondary LLM provider)
OPENCODE_HOST=http://localhost:8080
OPENCODE_MODEL=opencode-go
OPENCODE_API_KEY=your-opencode-key

# CFDI / Facturación electrónica (Facturapi)
# Déjalo vacío para emitir comprobantes provisionales imprimibles.
FACTURAPI_API_KEY=
FACTURAPI_BASE_URL=https://www.facturapi.io/v2
BUSINESS_RFC=
BUSINESS_NAME=Tienda Eaciot
BUSINESS_TAX_REGIME=601

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eaciot.com
SMTP_TLS=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tienda.eaciot.com/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://tienda.eaciot.com/auth/microsoft/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://tienda.eaciot.com/auth/github/callback

# Optional AI services
SEMANTIC_SEARCH_ENABLED=false
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=master_key

# Visual search requires open_clip + torch (install requirements-ai-innovations.txt)
# No extra env vars needed; runs via Ollama/CLIP when dependencies are present.

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
